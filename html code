<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CineBook · movie booking</title>
  <!-- Font Awesome for icons (optional but adds style) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }

    body {
      background: linear-gradient(145deg, #0b0f1a 0%, #121827 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      padding: 1.5rem;
    }

    .app {
      max-width: 1300px;
      width: 100%;
      background: rgba(18, 25, 40, 0.75);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 2.5rem;
      padding: 2rem 2rem 2.5rem;
      box-shadow: 0 30px 50px -15px rgba(0, 0, 0, 0.7);
    }

    /* header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .logo i {
      font-size: 2.4rem;
      color: #ffb347;
      text-shadow: 0 0 15px rgba(255, 180, 70, 0.4);
    }

    .logo h1 {
      font-size: 2rem;
      font-weight: 600;
      letter-spacing: -0.5px;
      color: #f0f3fa;
    }

    .logo span {
      color: #ffb347;
      font-weight: 700;
    }

    .user-badge {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      background: rgba(255, 255, 255, 0.05);
      padding: 0.6rem 1.4rem 0.6rem 1rem;
      border-radius: 50px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #cfd9e6;
      font-size: 0.95rem;
    }

    .user-badge i {
      font-size: 1.3rem;
      color: #ffb347;
    }

    /* movies grid */
    .section-title {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }

    .section-title i {
      font-size: 1.8rem;
      color: #ffb347;
    }

    .section-title h2 {
      font-size: 1.6rem;
      font-weight: 500;
      color: #eef3fc;
      letter-spacing: -0.3px;
    }

    .movie-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.8rem;
      margin-bottom: 2.5rem;
    }

    .movie-card {
      background: #1b2333;
      border-radius: 1.5rem;
      overflow: hidden;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.04);
      box-shadow: 0 12px 20px -8px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
    }

    .movie-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 30px -10px #00000099;
      border-color: rgba(255, 180, 70, 0.25);
    }

    .poster {
      height: 240px;
      background-size: cover;
      background-position: center;
      position: relative;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      padding: 0.8rem;
    }

    /* poster gradient overlay + emoji fallback */
    .poster::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, #0b0f1a 10%, transparent 70%);
      pointer-events: none;
    }

    .poster .rating {
      position: relative;
      z-index: 2;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      color: #ffd966;
      font-weight: 600;
      padding: 0.25rem 0.7rem;
      border-radius: 40px;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.25rem;
      border: 1px solid rgba(255, 210, 90, 0.3);
    }

    .movie-info {
      padding: 1rem 1rem 1.3rem;
    }

    .movie-info h3 {
      font-size: 1.2rem;
      font-weight: 600;
      color: #f0f5ff;
      margin-bottom: 0.4rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .movie-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #94a3b8;
      font-size: 0.85rem;
      margin-bottom: 1rem;
    }

    .movie-meta i {
      margin-right: 0.25rem;
      color: #ffb347;
    }

    .book-btn {
      width: 100%;
      background: #ffb347;
      color: #0b0f1a;
      font-weight: 700;
      border: none;
      padding: 0.7rem 0;
      border-radius: 40px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      letter-spacing: 0.3px;
      box-shadow: 0 6px 12px -4px #ffb34750;
    }

    .book-btn:hover {
      background: #ffa62b;
      box-shadow: 0 10px 18px -4px #ffb34770;
      transform: scale(1.02);
    }

    .book-btn i {
      font-size: 0.9rem;
    }

    /* booking panel */
    .booking-panel {
      background: #0f1624;
      border-radius: 2rem;
      padding: 1.8rem 2rem;
      border: 1px solid rgba(255, 255, 255, 0.05);
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4), 0 20px 30px -15px black;
      margin-top: 0.8rem;
    }

    .booking-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.8rem;
    }

    .selected-movie-info {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .selected-movie-info i {
      font-size: 2rem;
      color: #ffb347;
    }

    .selected-movie-info h3 {
      font-size: 1.4rem;
      font-weight: 500;
      color: #dde6f5;
    }

    .selected-movie-info h3 span {
      color: #ffb347;
      font-weight: 600;
    }

    .screen-indicator {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #95a5c0;
      background: #1a2336;
      padding: 0.4rem 1.3rem;
      border-radius: 40px;
      font-size: 0.95rem;
      border: 1px solid #2e3b52;
    }

    .screen-indicator i {
      color: #ffb347;
    }

    /* seat map */
    .seat-map {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 1.5rem 0 2rem;
    }

    .screen-curve {
      width: 80%;
      max-width: 550px;
      height: 24px;
      background: radial-gradient(ellipse at 50% 100%, #2e3f5e, #0b111e 85%);
      border-radius: 50% / 100% 100% 0 0;
      margin-bottom: 1.5rem;
      border-top: 2px solid #3e506e;
      box-shadow: 0 -6px 12px rgba(0, 0, 0, 0.6);
      transform: perspective(300px) rotateX(2deg);
    }

    .seats-row {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
    }

    .seat {
      width: 40px;
      height: 40px;
      background: #232e42;
      border-radius: 12px 12px 8px 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      font-weight: 600;
      color: #b7c9e2;
      cursor: pointer;
      transition: 0.12s ease;
      border: 1px solid #3b4a66;
      box-shadow: 0 6px 0 #0d121f;
      user-select: none;
    }

    .seat.available:hover {
      background: #ffb347;
      color: #0b0f1a;
      border-color: #ffb347;
      transform: translateY(-2px);
      box-shadow: 0 8px 0 #b16f1a;
    }

    .seat.selected {
      background: #ffb347;
      color: #0b0f1a;
      border-color: #ffcc80;
      box-shadow: 0 6px 0 #b16f1a;
      font-weight: 700;
    }

    .seat.occupied {
      background: #2a1f1f;
      color: #5e4a4a;
      border-color: #3a2c2c;
      box-shadow: 0 6px 0 #0d0a0a;
      cursor: not-allowed;
      text-decoration: line-through 1px #7a5a5a;
    }

    .seat.occupied::before {
      content: "✕";
      font-size: 0.9rem;
      opacity: 0.7;
    }

    .seat.occupied span {
      display: none;
    }

    /* legend + summary */
    .legend-summary {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      margin: 1.5rem 0 1.2rem;
      color: #b1c2da;
      font-size: 0.9rem;
    }

    .legend {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .legend-box {
      width: 20px;
      height: 20px;
      border-radius: 6px;
    }

    .legend-box.available {
      background: #232e42;
      border: 1px solid #3b4a66;
    }

    .legend-box.selected {
      background: #ffb347;
      border: 1px solid #ffcc80;
    }

    .legend-box.occupied {
      background: #2a1f1f;
      border: 1px solid #3a2c2c;
    }

    .total-price {
      background: #1b2537;
      padding: 0.5rem 1.5rem;
      border-radius: 50px;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 500;
      border: 1px solid #33425a;
    }

    .total-price i {
      color: #ffb347;
      font-size: 1.2rem;
    }

    .total-price span {
      color: #ffb347;
      font-weight: 700;
      font-size: 1.4rem;
      margin-left: 0.3rem;
    }

    .action-buttons {
      display: flex;
      gap: 1.2rem;
      justify-content: flex-end;
      flex-wrap: wrap;
      margin-top: 1.8rem;
    }

    .btn {
      border: none;
      padding: 0.9rem 2rem;
      border-radius: 50px;
      font-weight: 600;
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      cursor: pointer;
      transition: 0.15s;
      background: transparent;
      color: #cfd9e6;
      border: 1px solid #37465f;
    }

    .btn-primary {
      background: #ffb347;
      color: #0b0f1a;
      border: 1px solid #ffb347;
      box-shadow: 0 6px 14px -4px #ffb34760;
    }

    .btn-primary:hover {
      background: #ffa62b;
      transform: scale(1.02);
      box-shadow: 0 10px 20px -4px #ffb34780;
    }

    .btn-secondary:hover {
      background: #1b2537;
      border-color: #4b5d7a;
      color: #fff;
    }

    .btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .confirmation-message {
      margin-top: 1.2rem;
      text-align: center;
      color: #7cd992;
      background: #1b3b2b60;
      padding: 0.8rem;
      border-radius: 50px;
      font-weight: 500;
      border: 1px solid #2e6b48;
      display: none;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
    }

    .confirmation-message.show {
      display: flex;
    }

    /* responsive */
    @media (max-width: 700px) {
      .app {
        padding: 1.5rem;
      }
      .seat {
        width: 34px;
        height: 34px;
        font-size: 0.7rem;
      }
      .seats-row {
        gap: 0.5rem;
      }
      .booking-panel {
        padding: 1.5rem;
      }
      .legend-summary {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    @media (max-width: 450px) {
      .seat {
        width: 28px;
        height: 28px;
        font-size: 0.6rem;
      }
      .booking-header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <!-- header -->
    <div class="header">
      <div class="logo">
        <i class="fas fa-film"></i>
        <h1>Cine<span>Book</span></h1>
      </div>
      <div class="user-badge">
        <i class="fas fa-user-circle"></i>
        <span>Alex Rivera</span>
      </div>
    </div>

    <!-- now showing -->
    <div class="section-title">
      <i class="fas fa-video"></i>
      <h2>Now showing</h2>
    </div>

    <div class="movie-grid" id="movieGrid">
      <!-- movie cards will be injected by JS, but we also have static fallback (nice for HTML preview) -->
    </div>

    <!-- booking panel -->
    <div class="booking-panel">
      <div class="booking-header">
        <div class="selected-movie-info">
          <i class="fas fa-ticket-alt"></i>
          <h3><span id="selectedMovieTitle">Interstellar</span> · <span id="selectedShowtime">7:30 PM</span></h3>
        </div>
        <div class="screen-indicator">
          <i class="fas fa-tv"></i> SCREEN 4 · IMAX
        </div>
      </div>

      <!-- seat map -->
      <div class="seat-map" id="seatMap">
        <!-- dynamically generated seat rows -->
      </div>

      <!-- legend & total -->
      <div class="legend-summary">
        <div class="legend">
          <div class="legend-item"><div class="legend-box available"></div> Available</div>
          <div class="legend-item"><div class="legend-box selected"></div> Selected</div>
          <div class="legend-item"><div class="legend-box occupied"></div> Occupied</div>
        </div>
        <div class="total-price">
          <i class="fas fa-coins"></i> Total: <span id="totalAmount">$0</span>
        </div>
      </div>

      <!-- action buttons -->
      <div class="action-buttons">
        <button class="btn btn-secondary" id="clearSelectionBtn"><i class="fas fa-undo-alt"></i> Clear</button>
        <button class="btn btn-primary" id="confirmBookingBtn"><i class="fas fa-check-circle"></i> Confirm booking</button>
      </div>

      <!-- confirmation message -->
      <div class="confirmation-message" id="confirmationMsg">
        <i class="fas fa-check-circle"></i> <span id="confirmationText">Booking confirmed! Enjoy your movie.</span>
      </div>
    </div>
  </div>

  <script>
    (function() {
      // ---------- MOVIE DATA ----------
      const movies = [
        {
          id: 1,
          title: 'Interstellar',
          showtime: '7:30 PM',
          rating: 8.7,
          price: 12,
          poster: 'https://image.tmdb.org/t/p/w500/gEU2QniE6E77NI6lCU6MxlNBvIx.jpg' // interstellar
        },
        {
          id: 2,
          title: 'Dune: Part Two',
          showtime: '8:15 PM',
          rating: 8.5,
          price: 14,
          poster: 'https://image.tmdb.org/t/p/w500/1pdfLvkbY9ohJlCjQH2CZjjYVvJ.jpg'
        },
        {
          id: 3,
          title: 'Oppenheimer',
          showtime: '6:45 PM',
          rating: 8.9,
          price: 13,
          poster: 'https://image.tmdb.org/t/p/w500/8Gxv8gSFCU0XGDykEGv7zR1n2ua.jpg'
        },
        {
          id: 4,
          title: 'The Batman',
          showtime: '9:00 PM',
          rating: 7.9,
          price: 11,
          poster: 'https://image.tmdb.org/t/p/w500/74xTEgt7R36Fpooo50r9T25onhq.jpg'
        }
      ];

      // ---------- STATE ----------
      let selectedMovie = movies[0];            // default: Interstellar
      let selectedSeats = new Set();            // store seat identifiers like "A1"
      const ROWS = ['A', 'B', 'C', 'D', 'E', 'F'];
      const SEATS_PER_ROW = 8;
      // pre-occupied seats (static, for demo)
      const occupiedSeats = new Set([
        'A3', 'A4', 'B6', 'C2', 'C3', 'D5', 'E7', 'E8', 'F1', 'F2'
      ]);

      // DOM elements
      const movieGridEl = document.getElementById('movieGrid');
      const seatMapEl = document.getElementById('seatMap');
      const selectedMovieTitleEl = document.getElementById('selectedMovieTitle');
      const selectedShowtimeEl = document.getElementById('selectedShowtime');
      const totalAmountEl = document.getElementById('totalAmount');
      const clearBtn = document.getElementById('clearSelectionBtn');
      const confirmBtn = document.getElementById('confirmBookingBtn');
      const confirmationMsg = document.getElementById('confirmationMsg');
      const confirmationText = document.getElementById('confirmationText');

      // ---------- RENDER MOVIE CARDS ----------
      function renderMovies() {
        movieGridEl.innerHTML = movies.map(movie => `
          <div class="movie-card" data-movie-id="${movie.id}">
            <div class="poster" style="background-image: url('${movie.poster}'), linear-gradient(145deg, #1e2b3f, #0f1624);">
              <div class="rating"><i class="fas fa-star"></i> ${movie.rating}</div>
            </div>
            <div class="movie-info">
              <h3>${movie.title}</h3>
              <div class="movie-meta">
                <span><i class="far fa-clock"></i> ${movie.showtime}</span>
                <span><i class="fas fa-tag"></i> $${movie.price}</span>
              </div>
              <button class="book-btn" data-movie-id="${movie.id}">
                <i class="fas fa-chair"></i> Select seats
              </button>
            </div>
          </div>
        `).join('');

        // attach event listeners to "Select seats" buttons (and whole card optional)
        document.querySelectorAll('.book-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const movieId = Number(btn.dataset.movieId);
            const movie = movies.find(m => m.id === movieId);
            if (movie) selectMovie(movie);
          });
        });

        // make card also clickable
        document.querySelectorAll('.movie-card').forEach(card => {
          card.addEventListener('click', (e) => {
            // avoid double trigger if click on button
            if (e.target.closest('.book-btn')) return;
            const movieId = Number(card.dataset.movieId);
            const movie = movies.find(m => m.id === movieId);
            if (movie) selectMovie(movie);
          });
        });
      }

      // ---------- SELECT MOVIE ----------
      function selectMovie(movie) {
        selectedMovie = movie;
        selectedSeats.clear();               // reset seat selection
        selectedMovieTitleEl.textContent = movie.title;
        selectedShowtimeEl.textContent = movie.showtime;
        renderSeatMap();
        updateTotal();
        hideConfirmation();
      }

      // ---------- RENDER SEAT MAP ----------
      function renderSeatMap() {
        // build rows
        let rowsHtml = '';
        // screen curve
        rowsHtml += `<div class="screen-curve"></div>`;

        ROWS.forEach(rowLetter => {
          let seatsHtml = '';
          for (let i = 1; i <= SEATS_PER_ROW; i++) {
            const seatId = `${rowLetter}${i}`;
            const isOccupied = occupiedSeats.has(seatId);
            const isSelected = selectedSeats.has(seatId);
            const seatClass = `seat ${isOccupied ? 'occupied' : 'available'} ${isSelected ? 'selected' : ''}`;
            // For occupied seats, show ✕ via CSS (pseudo) — we use a span for accessibility, but it's hidden by css
            seatsHtml += `<div class="${seatClass}" data-seat-id="${seatId}" data-row="${rowLetter}" data-number="${i}">
                            <span>${rowLetter}${i}</span>
                          </div>`;
          }
          rowsHtml += `<div class="seats-row">${seatsHtml}</div>`;
        });

        seatMapEl.innerHTML = rowsHtml;

        // attach click listeners to seats (only available & not occupied)
        document.querySelectorAll('.seat.available').forEach(seatEl => {
          seatEl.addEventListener('click', (e) => {
            const seatId = seatEl.dataset.seatId;
            if (!seatId) return;
            // toggle selection
            if (selectedSeats.has(seatId)) {
              selectedSeats.delete(seatId);
            } else {
              selectedSeats.add(seatId);
            }
            // update visual class
            seatEl.classList.toggle('selected');
            updateTotal();
            hideConfirmation();
          });
        });
      }

      // ---------- UPDATE TOTAL PRICE ----------
      function updateTotal() {
        const total = selectedSeats.size * selectedMovie.price;
        totalAmountEl.textContent = `$${total}`;
      }

      // ---------- CLEAR SELECTION ----------
      function clearSelection() {
        selectedSeats.clear();
        // re-render seat map to remove selected classes
        renderSeatMap();
        updateTotal();
        hideConfirmation();
      }

      // ---------- CONFIRM BOOKING ----------
      function confirmBooking() {
        if (selectedSeats.size === 0) {
          alert('Please select at least one seat.');
          return;
        }

        // mark seats as occupied (simulate)
        selectedSeats.forEach(seatId => {
          occupiedSeats.add(seatId);
        });

        const seatList = Array.from(selectedSeats).sort().join(', ');
        const total = selectedSeats.size * selectedMovie.price;

        // show confirmation message
        confirmationText.textContent = `✅ ${selectedSeats.size} seat(s) (${seatList}) for ${selectedMovie.title} · Total $${total}`;
        confirmationMsg.classList.add('show');

        // clear selected seats (they are now occupied)
        selectedSeats.clear();

        // re-render seat map with new occupied
        renderSeatMap();
        updateTotal();

        // auto hide confirmation after 5 seconds
        setTimeout(() => {
          hideConfirmation();
        }, 6000);
      }

      function hideConfirmation() {
        confirmationMsg.classList.remove('show');
      }

      // ---------- INITIALIZATION ----------
      function init() {
        renderMovies();
        // set default selected movie (Interstellar)
        selectedMovie = movies[0];
        selectedMovieTitleEl.textContent = selectedMovie.title;
        selectedShowtimeEl.textContent = selectedMovie.showtime;
        renderSeatMap();
        updateTotal();

        // event listeners for buttons
        clearBtn.addEventListener('click', clearSelection);
        confirmBtn.addEventListener('click', confirmBooking);
      }

      init();
    })();
  </script>
</body>
</html>
